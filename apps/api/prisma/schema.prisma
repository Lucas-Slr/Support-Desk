generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  CUSTOMER
  AGENT
  ADMIN
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum Visibility {
  PUBLIC
  INTERNAL
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  displayName String
  role Role @default(CUSTOMER)
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  tickets Ticket[] @relation("Author")
  assignedTickets Ticket[] @relation("Agent")
  messages TicketMessage[]
  auditEvents AuditEvent[]
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash String
  expiresAt DateTime
  revokedAt DateTime?
  lastUsedAt DateTime @default(now())
  userAgent String? @db.VarChar(256)
  createdAt DateTime @default(now())
  @@index([userId, revokedAt])
}
model Ticket {
  id String @id @default(uuid()) @db.Uuid
  authorId String @db.Uuid
  author User @relation("Author", fields: [authorId], references: [id])
  assignedAgentId String? @db.Uuid
  assignedAgent User? @relation("Agent", fields: [assignedAgentId], references: [id])
  subject String @db.VarChar(160)
  description String
  status TicketStatus @default(OPEN)
  priority Priority @default(MEDIUM)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  messages TicketMessage[]
  @@index([authorId, createdAt])
  @@index([assignedAgentId, status])
}
model TicketMessage {
  id String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String @db.Uuid
  author User @relation(fields: [authorId], references: [id])
  content String
  visibility Visibility @default(PUBLIC)
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  targetType String
  targetId String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  @@index([createdAt])
}
