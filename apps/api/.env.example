# Copier vers .env dans apps/api. Générer un secret aléatoire de 32 octets minimum.
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
DATABASE_URL=postgresql://support:CHANGE_ME@localhost:5432/support_desk
TEST_DATABASE_URL=postgresql://support:CHANGE_ME@localhost:5433/support_desk_test
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=support-desk-api
JWT_AUDIENCE=support-desk-web
ALLOWED_ORIGINS=http://localhost:4200
DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_PASSPHRASE
